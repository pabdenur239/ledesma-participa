# Copiar como .env y completar solo localmente. .env está ignorado por Git.

# Page ID de la página de Facebook "Ledesma Participa" (dato público, no es
# secreto). Si se omite, el cliente usa el valor confirmado por defecto.
META_PAGE_ID=1174992842373499

# Token de acceso de la página en Meta. NUNCA versionar el valor real:
# se obtiene desde Meta for Developers y se completa solo en el .env local.
# Necesita los permisos pages_manage_posts, pages_read_engagement e
# instagram_content_publish habilitados en la app de Meta for Developers.
META_PAGE_ACCESS_TOKEN=

# ID de la cuenta de Instagram profesional vinculada a la página de
# Facebook (Instagram Business Account ID). Se obtiene desde Meta for
# Developers una vez vinculada la cuenta. Sin esto, el sistema publica en
# Facebook pero Instagram queda en error (no bloquea Facebook).
META_IG_USER_ID=

# No hace falta ninguna variable de hosting/URL pública propia para las
# imágenes: Instagram reutiliza la URL pública (CDN) que la propia Meta le
# asigna a la placa apenas se publica en Facebook (ver
# motor_noticias/meta/publicador.py). No se requiere exponer el panel a
# Internet para publicar en Instagram.
