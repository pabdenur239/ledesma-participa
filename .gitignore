# Entorno y secretos
.env
.env.*
*.env
!.env.example
secrets/
credentials/
*.pem
*.key

# Temporales comunes
*.log
*.tmp
.DS_Store
Thumbs.db
node_modules/
__pycache__/
*.pyc

# Base de datos generada localmente
data/*.db
data/*.sqlite3

# Placas generadas automáticamente
data/placas/

# Lock de instancia única del Motor Continuo (runtime, con el PID vivo de
# esta máquina — nunca debe versionarse)
data/*.lock

.venv/
data/reels/

# Binarios de la app Android (APK/AAB) generados en exports/android/ — se
# guardan ahí como entregable local, no se versionan (pesan ~50 MB c/u).
exports/android/*.apk
exports/android/*.aab

# Piloto audiovisual: modelos, muestras de voz y salidas (no se versionan)
produccion_audiovisual/piloto_periodistas/modelos_voz/
produccion_audiovisual/piloto_periodistas/muestras_voz/
produccion_audiovisual/piloto_periodistas/muestras_voz_final/
produccion_audiovisual/piloto_periodistas/muestras_voz_natural/
produccion_audiovisual/piloto_periodistas/salidas/
produccion_audiovisual/piloto_periodistas/__pycache__/
